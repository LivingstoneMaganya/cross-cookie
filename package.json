{
  "name": "@maganya/cross-cookie",
  "version": "1.0.2",
  "description": "Zero-dependency Web Standards cookie parser for Node, Bun, Deno, and Edge environments.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LivingstoneMaganya/cross-cookie.git"
  },
  "bugs": {
    "url": "https://github.com/LivingstoneMaganya/cross-cookie/issues"
  },
  "homepage": "https://github.com/LivingstoneMaganya/cross-cookie#readme",
  "keywords": [
    "cookie",
    "cookies",
    "cookie-parser",
    "web-standards",
    "edge",
    "cloudflare-workers",
    "nextjs",
    "bun",
    "deno",
    "zero-dependency"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run test && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}